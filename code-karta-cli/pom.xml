<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.karta</groupId>
        <artifactId>code-karta</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>code-karta-cli</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.karta</groupId>
            <artifactId>code-karta-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.karta</groupId>
            <artifactId>code-karta-input</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.karta</groupId>
            <artifactId>code-karta-layout</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.karta</groupId>
            <artifactId>code-karta-render</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>se.deversity.vibetags</groupId>
            <artifactId>vibetags-processor</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Run during development via: mvn -pl code-karta-cli exec:java with Dexec.args -->
            <!-- Diagram generation runs in verify phase: mvn verify -DskipTests              -->
            <!-- Skip with: -DskipDiagrams=true                                               -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.karta.cli.KartaCli</mainClass>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                </configuration>
                <executions>
                    <!-- 1. Module diagram -->
                    <execution>
                        <id>gen-module-diagram</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/module-info.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 2. Class diagram — core IR model -->
                    <execution>
                        <id>gen-class-diagram</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-core/src/main/java/com/karta/core/model</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 3. Exception-flow sequence — CLI entry point -->
                    <execution>
                        <id>gen-cli-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-cli/src/main/java/com/karta/cli/KartaCli.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 4. Call-sequence-only — CallSequenceParser (shows sequence-only) -->
                    <execution>
                        <id>gen-call-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-input/src/main/java/com/karta/input/parser/CallSequenceParser.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                                <argument>--sequence-only</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 5. Multi-file stitched sequence — input parsers with ELK layout -->
                    <execution>
                        <id>gen-multifile-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-input/src/main/java/com/karta/input</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                                <argument>--sequence-only</argument>
                                <argument>--layout</argument>
                                <argument>elk</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Fat JAR: mvn package produces target/code-karta-cli-1.0-SNAPSHOT-all.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.karta.cli.KartaCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
