<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>se.deversity.codekarta</groupId>
        <artifactId>code-karta</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>code-karta-cli</artifactId>
    <name>CodeKarta CLI</name>
    <description>Command line interface wrapper for CodeKarta</description>

    <properties>
        <!-- The CLI targets 17 as well, so the fat jar runs on a 17 JVM. See <library.release> in
             the parent pom. -->
        <maven.compiler.release>${library.release}</maven.compiler.release>
        <maven.compiler.testRelease>21</maven.compiler.testRelease>

        <!-- Floors, not targets. Measured on 2026-08-12: line 45.0%, mutation 34.5%.
             Raise these when the numbers rise; never lower one to make a red build
             green. The reactor-wide defaults live in the parent pom. -->
        <jacoco.line.minimum>0.92</jacoco.line.minimum>
        <pitest.mutation.minimum>88</pitest.mutation.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>se.deversity.codekarta</groupId>
            <artifactId>code-karta-core</artifactId>
        </dependency>
        <dependency>
            <groupId>se.deversity.codekarta</groupId>
            <artifactId>code-karta-input</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>se.deversity.codekarta</groupId>
            <artifactId>code-karta-layout</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>se.deversity.codekarta</groupId>
            <artifactId>code-karta-render</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>se.deversity.vibetags</groupId>
            <artifactId>vibetags-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- version.properties carries the project version the CLI prints for its version flag (#278). Only that file
             is filtered, so no other resource can have a ${...} replaced by accident. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Run during development via: mvn -pl code-karta-cli exec:java with Dexec.args -->
            <!-- Diagram generation runs in verify phase: mvn verify -DskipTests              -->
            <!-- Skip with: -DskipDiagrams=true                                               -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>se.deversity.codekarta.cli.KartaCli</mainClass>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                </configuration>
                <executions>
                    <!-- 1. Module diagram -->
                    <execution>
                        <id>gen-module-diagram</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/module-info.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 2. Class diagram — core IR model -->
                    <execution>
                        <id>gen-class-diagram</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-core/src/main/java/se/deversity/codekarta/core/model</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 3. Exception-flow sequence — CLI entry point -->
                    <execution>
                        <id>gen-cli-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-cli/src/main/java/se/deversity/codekarta/cli/KartaCli.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 4. Call-sequence-only — CallSequenceParser (shows sequence-only) -->
                    <execution>
                        <id>gen-call-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-input/src/main/java/se/deversity/codekarta/input/parser/CallSequenceParser.java</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                                <argument>--sequence-only</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 5. Multi-file stitched sequence — input parsers with ELK layout -->
                    <execution>
                        <id>gen-multifile-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-input/src/main/java/se/deversity/codekarta/input</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                                <argument>--sequence-only</argument>
                                <argument>--layout</argument>
                                <argument>elk</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 6-13. State machines, the example project's diagrams and the viewer. Regenerated here so
                         the "regeneration is committed" gate covers them; all seven drifted
                         unnoticed while this list left them out (#249). Keep this list in step with
                         the generateDiagrams task in build.gradle.kts, which CI checks produces the
                         same bytes. -->
                    <!-- 6. KartaCli pipeline stages -->
                    <execution>
                        <id>gen-cli-state-machine</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>code-karta-cli/src/main/java/se/deversity/codekarta/cli/KartaCli.java</argument>
                                <argument>--state-machine</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 7. Example: switch-case transitions -->
                    <execution>
                        <id>gen-shipment-state-machine</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/com/karta/shipping/state/ShipmentLifecycle.java</argument>
                                <argument>--state-machine</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 8. Example: transition(from, to, event) DSL -->
                    <execution>
                        <id>gen-payment-state-machine</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/com/karta/shipping/state/PaymentWorkflow.java</argument>
                                <argument>--state-machine</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 9. Example: linear state assignments -->
                    <execution>
                        <id>gen-inventory-state-machine</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/com/karta/shipping/state/InventoryReservation.java</argument>
                                <argument>--state-machine</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 10. Example: module diagram -->
                    <execution>
                        <id>gen-example-module</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/module-info.java</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 11. Example: class diagram -->
                    <execution>
                        <id>gen-example-class</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/com/karta/shipping/domain</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 12. Example: exception-flow sequence -->
                    <execution>
                        <id>gen-example-sequence</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--input</argument>
                                <argument>example-shipping-system/src/main/java/com/karta/shipping/core/OrderProcessor.java</argument>
                                <argument>--output</argument>
                                <argument>example-shipping-system/diagrams</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- 13. The viewer over docs/diagrams. Last, so it indexes every SVG above. -->
                    <execution>
                        <id>gen-viewer</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${skipDiagrams}</skip>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                                <argument>--output</argument>
                                <argument>docs/diagrams</argument>
                                <argument>--viewer</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Fat JAR: mvn package produces target/code-karta-cli-1.0-SNAPSHOT-all.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <!-- The shaded jar is an attached artifact (classifier "all"); the main jar is not
                                 shaded. The dependency-reduced pom is therefore wrong for the artifact it
                                 replaces: it strips the four compile dependencies that the unshaded main jar
                                 needs. code-karta-cli-0.3.0.pom on Maven Central has no compile-scope
                                 dependency at all, so declaring code-karta-cli as a dependency resolves a jar
                                 of three classes and nothing to run them against. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>se.deversity.codekarta.cli.KartaCli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
