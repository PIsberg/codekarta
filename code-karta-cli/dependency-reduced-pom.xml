<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>code-karta</artifactId>
    <groupId>com.karta</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>code-karta-cli</artifactId>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>gen-module-diagram</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipDiagrams}</skip>
              <executable>java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                <argument>--input</argument>
                <argument>example-shipping-system/src/main/java/module-info.java</argument>
                <argument>--output</argument>
                <argument>docs/diagrams</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>gen-class-diagram</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipDiagrams}</skip>
              <executable>java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                <argument>--input</argument>
                <argument>code-karta-core/src/main/java/com/karta/core/model</argument>
                <argument>--output</argument>
                <argument>docs/diagrams</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>gen-cli-sequence</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipDiagrams}</skip>
              <executable>java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                <argument>--input</argument>
                <argument>code-karta-cli/src/main/java/com/karta/cli/KartaCli.java</argument>
                <argument>--output</argument>
                <argument>docs/diagrams</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>gen-call-sequence</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipDiagrams}</skip>
              <executable>java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                <argument>--input</argument>
                <argument>code-karta-input/src/main/java/com/karta/input/parser/CallSequenceParser.java</argument>
                <argument>--output</argument>
                <argument>docs/diagrams</argument>
                <argument>--sequence-only</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>gen-multifile-sequence</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipDiagrams}</skip>
              <executable>java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/${project.artifactId}-${project.version}-all.jar</argument>
                <argument>--input</argument>
                <argument>code-karta-input/src/main/java/com/karta/input</argument>
                <argument>--output</argument>
                <argument>docs/diagrams</argument>
                <argument>--sequence-only</argument>
                <argument>--layout</argument>
                <argument>elk</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.karta.cli.KartaCli</mainClass>
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <transformers>
                <transformer>
                  <mainClass>com.karta.cli.KartaCli</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>se.deversity.vibetags</groupId>
      <artifactId>vibetags-processor</artifactId>
      <version>0.9.5</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
