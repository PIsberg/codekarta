<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for code-karta.
  Excludes intentional patterns that are not genuine bugs.
-->
<FindBugsFilter>

  <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: the Core IR (Node, Edge, Group, Graph) is a
       mutable POJO model by design — Tier 2 layout mutates Node.x/y/width/height
       in place. Immutability is enforced architecturally (tiers don't cross-call),
       not via defensive copies (see CLAUDE.md "Key Constraints"). -->
  <Match>
    <Package name="com.karta.core.model"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- VA_FORMAT_STRING_USES_NEWLINE: the renderers emit SVG text, which must use
       \n regardless of platform. %n would produce \r\n on Windows and change the
       generated diagram bytes (golden files in docs/diagrams/ and the integration
       fixture would diverge per-OS). -->
  <Match>
    <Package name="com.karta.render"/>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
  </Match>

  <!-- NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: with the JSpecify @Nullable
       annotations on Node coordinate getters and Edge.getLabel(), SpotBugs flags
       every re-read after a null check (`getX() != null ? getX() : ...` and the
       "x != null implies y/width/height != null" layout invariant — Tier 2 sets
       all four or none, see CLAUDE.md). The renderers guard on getX()/findNode()
       before dereferencing; SpotBugs cannot track the cross-getter invariant. -->
  <Match>
    <Package name="com.karta.render"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!-- REC_CATCH_EXCEPTION: the fault-tolerance rule (CLAUDE.md) requires every
       parser to wrap JavaParser calls in a broad try/catch, log a warning, and
       return a partial graph — never crash. Catching Exception is the contract. -->
  <Match>
    <Or>
      <Package name="com.karta.input"/>
      <Package name="com.karta.input.parser"/>
    </Or>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

</FindBugsFilter>
